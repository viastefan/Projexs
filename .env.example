# Öffentliche Basis-URL der Website (für Canonical-, OG- und Sitemap-URLs)
NEXT_PUBLIC_SITE_URL=https://www.projexs.de

# Kontaktformular-Versand über Resend (https://resend.com)
# Ohne API-Key bleibt das Formular funktionsfähig und bietet den Versand per E-Mail-Programm an.
RESEND_API_KEY=
# Empfänger der Anfragen
CONTACT_TO_EMAIL=DanielaFranzen@projexs.de
# Absender – Domain muss in Resend verifiziert sein
CONTACT_FROM_EMAIL=ProjeXs Website <website@projexs.de>
