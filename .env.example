# Vorlage für die Umgebungsvariablen. Für die Produktion in den Einstellungen
# des Hosters eintragen (Vercel → Settings → Environment Variables), lokal in
# eine Datei `.env.local` kopieren. `.env.local` gehört nicht ins Repository.

# ---------------------------------------------------------------------------
# Website
# ---------------------------------------------------------------------------
# Öffentliche Basis-URL (für Canonical-, OG- und Sitemap-URLs)
NEXT_PUBLIC_SITE_URL=https://www.projexs.de

# ---------------------------------------------------------------------------
# E-Mail-Versand (Kontaktformular, Benachrichtigungen, Antworten aus der App)
# ---------------------------------------------------------------------------
# Zwei Wege, der erste vollständig gesetzte gewinnt. Ist keiner gesetzt (und
# kein Speicher), bietet das Formular den Versand per E-Mail-Programm an.

# --- Weg 1: SMTP (Normalfall, z. B. das IONOS-Postfach) ----------------------
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587            # 587 mit STARTTLS (üblich) oder 465 mit direktem TLS
SMTP_USER=website@projexs.de
SMTP_PASS=               # niemals ins Repository schreiben
# SMTP_SECURE=true       # nur setzen, wenn Port 465 ohne STARTTLS gemeint ist

# --- Weg 2: Resend (https://resend.com) --------------------------------------
# RESEND_API_KEY=

# Absender der Benachrichtigung. Muss zur eigenen Domain gehören, sonst greifen
# SPF und DKIM nicht und die Mail landet im Spam. Ohne Angabe: SMTP_USER.
CONTACT_FROM_EMAIL=ProjeXs Website <website@projexs.de>
# Postfach, in dem neue Anfragen ankommen. Ohne Angabe die Adresse aus content/site.ts.
CONTACT_TO_EMAIL=Daniela.Franzen@projexs.de

# Eingangsbestätigung an Anfragende — fester Text ohne Angaben aus dem
# Formular, je Adresse höchstens eine am Tag. Ohne Angabe geht keine raus.
# CONFIRMATION_FROM=Daniela.Franzen@projexs.de
# Absender für Antworten direkt aus der Admin-App (sonst CONFIRMATION_FROM,
# sonst bei SMTP das Postfach selbst). Ohne Adresse öffnet die App das Mailprogramm.
# REPLY_FROM=Daniela.Franzen@projexs.de

# ---------------------------------------------------------------------------
# Admin-App (/admin)
# ---------------------------------------------------------------------------
# Speicher: ein privater Vercel-Blob-Store in Frankfurt (fra1). Beim Verbinden
# mit dem Projekt legt Vercel den Schlüssel selbst an. Darin liegen Anfragen,
# Zugänge, Einstellungen, Inhalts-Änderungen und Push-Abos als JSON.
# BLOB_READ_WRITE_TOKEN=

# Lokal statt Vercel Blob: alles unter .data/ — nur für Entwicklung und Tests.
# STORAGE_DRIVER=local

# Signiert die Anmelde-Cookies und die Vorschau-Links. Mindestens 32 Zeichen:
#   openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Sechsstellige PIN von Daniela. Legt beim ersten Öffnen ihren Zugang an und
# bleibt als Notzugang gültig, falls die in der App geänderte PIN vergessen ist.
ADMIN_PIN=

# Schützt den täglichen Aufräum-Cron (/api/cron/aufbewahrung, siehe vercel.json).
# Vercel schickt den Wert automatisch mit, sobald die Variable gesetzt ist.
CRON_SECRET=

# Push-Benachrichtigungen: Ohne Angabe erzeugt die App beim ersten Bedarf
# selbst ein Schlüsselpaar und legt es im privaten Speicher ab. Eigene
# Schlüssel: npx web-push generate-vapid-keys — ein Wechsel macht alle Abos
# ungültig, Push muss dann auf den Geräten neu eingeschaltet werden.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Kontakt für die Push-Dienste (mailto: oder https:). Standard: die Website-URL.
# VAPID_SUBJECT=mailto:Daniela.Franzen@projexs.de
